// secrets.h.example — MÁSOLD "secrets.h"-ra és töltsd ki.
// A valódi secrets.h GITIGNORE-olt, soha ne kerüljön a repóba.
#pragma once

// --- WiFi -------------------------------------------------------------------
#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// --- Firebase ---------------------------------------------------------------
// Web API key: Firebase Console → Project settings → General → Web API Key
#define FIREBASE_API_KEY "AIzaSy............................"

// RTDB URL: Firebase Console → Realtime Database → a példány URL-je.
// Záró '/' opcionális. Pl. EU régió:
//   https://<project-id>-default-rtdb.europe-west1.firebasedatabase.app
#define DATABASE_URL "https://<project-id>-default-rtdb.<region>.firebasedatabase.app"

// --- Dedikált eszköz-user (Firebase Auth → Email/Password szolgáltató) ------
// Hozd létre a konzolon; ezzel az emaillel engedélyez az írást a Security Rules.
#define DEVICE_USER_EMAIL    "device@example.com"
#define DEVICE_USER_PASSWORD "change-me-strong-password"
