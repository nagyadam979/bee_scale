# bee_scale NODE firmware — ESP32-C3 SuperMini · sdkconfig.defaults
#
# Cél: deep-sleep ciklusban mérés + ESP-NOW broadcast. A WiFi/ESP-NOW-t a framework alapból
# tartalmazza; itt csak a konzolt, flash-méretet és a log-szintet rögzítjük.

# --- Konzol a natív USB-Serial-JTAG-on ---
# Az ESP32-C3 SuperMini-nek NINCS külön USB-UART bridge chipje: a USB-C közvetlenül a C3
# beépített USB-Serial-JTAG-jára megy. (Mint a H1/H2/Sz2/M1 node-ban.)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- Flash méret ---
# A board-def (esp32-c3-devkitm-1) 4 MB-ot vár; a legtöbb ESP32-C3 SuperMini 4 MB.
# HA a darabod más (1/2 MB), állítsd át.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- Soros log szint: INFO. ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Boot gyorsítás: kevesebb bootloader-zaj (deep-sleep ciklusban gyakori reboot). ---
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
