{
  "rules": {
    ".read": false,
    ".write": false,

    "hives": {
      "$hive": {
        "//": "Olvasás: bármely HITELESÍTETT kliens (read-only web app, viewer user).",
        ".read": "auth != null",

        "readings": {
          "//": "Írás: KIZÁRÓLAG a dedikált eszköz-user (email-egyezés). Cseréld ki a saját eszköz-user emailedre. A viewer userek nem írhatnak.",
          ".write": "auth != null && auth.token.email === 'esp32@beescale.local'",

          ".indexOn": ["ts"],

          "$pushId": {
            ".validate": "newData.hasChildren(['ts','w_total','w1','w2'])",
            "ts":      { ".validate": "newData.isNumber() && newData.val() > 1700000000" },
            "w_total": { ".validate": "newData.isNumber()" },
            "w1":      { ".validate": "newData.isNumber()" },
            "w2":      { ".validate": "newData.isNumber()" },
            "$other":  { ".validate": false }
          }
        }
      }
    }
  }
}
